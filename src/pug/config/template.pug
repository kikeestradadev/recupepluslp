block config
	-let currentPage 		= 'home'
	-let content 			= 'My Page'
	-let siteName 			= 'Recupé Plus'
	-let pageDescription 	= 'Here is the description Page.'
	-let pageTitle 			= null
	-let pageLang 			= 'es'
include ../data/site-data
include ../components/shared/floating-button
doctype html
html(lang=pageLang prefix='og: http://ogp.me/ns#', class='no-js')
	head
		meta(charset="utf-8")
		meta(name="viewport", content="width=device-width, initial-scale=1.0")
		script.
			document.documentElement.classList.remove('no-js');
			document.documentElement.classList.add('js');
			window.setTimeout(function () {
				if (document.documentElement.dataset.componentsReady === 'true') return;
				document.querySelectorAll('.lazy-sections > section:not(:first-of-type), [data-lazy-component]').forEach(function (section) {
					section.classList.add('component-loader--ready');
					section.setAttribute('aria-busy', 'false');
				});
			}, 8000);
		meta(name='format-detection', content='telephone=no')
		meta(name="theme-color", content="#0096D9")
		link(rel="shortcut icon", type="image/png", href="./assets/drive_24_julio/favco.png")
		link(rel="apple-touch-icon", href="./assets/drive_24_julio/favco.png")
		meta(name="description", content=pageDescription)
		meta(http-equiv="Content-Security-Policy", content="upgrade-insecure-requests")
		meta(http-equiv="Cache-Control", content="no-cache, no-store, must-revalidate")
		meta(http-equiv="Expires", content="0")
		meta(http-equiv="Pragma", content="no-cache") 
		link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css")
		link(rel="preconnect" href="https://fonts.googleapis.com")
		link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
		link(href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet")
		link(rel="stylesheet" href="./assets/prism.css")
		link(rel="stylesheet" href=`styles.css?v=${siteData.assetVersion}`)
		title= (pageTitle || (currentPage.slice(0,1).toUpperCase() + currentPage.slice(1))) + " - " + siteName
	body(class=currentPage, itemscope itemtype="http://schema.org/WebPage")
		//- here start the Main Header
		header(class='main-header')
			include ../components/shared/main-menu
			block main-header
		//- here ends the Main Header
		//- here start the Main Container
		main(class='lazy-sections')
			block main-container
		//- here ends the Main Container
		//- El footer alternativo es una muestra exclusiva del style guide
		
		include ../components/shared/alt-footer		
		//- here ends the Main Footer
		include ../components/shared/whatsapp-button
		if currentPage === 'home'
			+floatingButton('style-guide.html', 'Style Guide')
		else if currentPage === 'style-guide'
			+floatingButton('index.html', 'Home')
		script.
			window.lazySizesConfig = window.lazySizesConfig || {};
			window.lazySizesConfig.expand = 480;
			window.lazySizesConfig.expFactor = 1.5;
			window.lazySizesConfig.iframeLoadMode = 1;
		script(src="https://cdn.jsdelivr.net/npm/lazysizes@5.3.2/lazysizes.min.js")
		script(src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js")
		script(src="https://cdn.jsdelivr.net/npm/prismjs@1.30.0/prism.min.js")
		script(src=`index.js?v=${siteData.assetVersion}`)
		block scripts
