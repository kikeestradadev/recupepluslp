section(class='allies-slider')
	div(class='allies-slider__inner')
		h2(class='allies-slider__title') También disponibles en nuestros aliados

		div(class='allies-slider__slider')
			div(class='allies-slider__swiper swiper')
				div(class='allies-slider__wrapper swiper-wrapper')
					- const alliesCount = 12
					- for (let i = 0; i < alliesCount; i++)
						article(class='allies-slider__slide swiper-slide')
							div(class='allies-slider__card')
								img(class='allies-slider__logo' src='./assets/logoAM.svg' alt='Aliado' width='120' height='80' loading='lazy')

				div(class='allies-slider__pagination swiper-pagination')
