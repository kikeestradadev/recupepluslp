include ../data/format-cards-data

section(class='format-cards')
	div(class='main-container format-cards__shell')
		div(class='container format-cards__container format-cards__inner')
			h2(class='format-cards__title')= formatCardsData.title

			div(class='format-cards__grid')
				each card in formatCardsData.items
					article(class=`format-cards__card format-cards__card--${card.modifier}`)
						div(class='format-cards__content')
							h3(class='format-cards__name')= card.title
							p(class='format-cards__text')= card.text
							ul(class='format-cards__list')
								each product in card.products
									li(class='format-cards__item')= product
							a(class='format-cards__cta' href=card.href)= card.cta
						div(class='format-cards__media')
							img(
								class='format-cards__image'
								src=card.image
								alt=card.alt
								width=card.width
								height=card.height
								loading='lazy'
							)
