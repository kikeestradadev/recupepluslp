include ../data/supplements-banner-data

section(class='supplements-banner' aria-label=supplementsBannerData.alt)
	figure(class='supplements-banner__figure')
		picture(class='supplements-banner__picture')
			source(
				media='(width >= 1280px)'
				srcset=supplementsBannerData.imageDesktop
			)
			source(
				media='(width >= 1024px)'
				srcset=supplementsBannerData.imageTablet
			)
			img(
				class='supplements-banner__image'
				src=supplementsBannerData.imageMobile
				alt=supplementsBannerData.alt
				width='1600'
				height='600'
				loading='eager'
				fetchpriority='high'
			)

		div(class='supplements-banner__content')
			div(class='supplements-banner__copy')
				h1(class='supplements-banner__title')= supplementsBannerData.title
				p(class='supplements-banner__text')= supplementsBannerData.text
