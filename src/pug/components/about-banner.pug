include ../data/about-banner-data

section(class='about-banner' aria-label='Una marca costarricense creada para hacer más simple cuidarte')
	div(class='about-banner__layout')
		div(class='about-banner__media')
			img(
				class='about-banner__image'
				src=aboutBannerData.image
				alt=aboutBannerData.alt
				width='1200'
				height='900'
				loading='eager'
				fetchpriority='high'
			)

		div(class='about-banner__content')
			div(class='about-banner__copy')
				h1(class='about-banner__title')
					each line in aboutBannerData.titleLines
						span(class=line.accent ? 'about-banner__title-line about-banner__title-line--accent' : 'about-banner__title-line')= line.text
				p(class='about-banner__text')= aboutBannerData.text

				div(class='about-banner__actions')
					a(class='about-banner__button about-banner__button--primary' href=aboutBannerData.primaryCta.href)= aboutBannerData.primaryCta.label
					a(class='about-banner__button about-banner__button--whatsapp' href=aboutBannerData.whatsappCta.href)
						svg(class='about-banner__button-icon' width='18' height='18' viewBox='0 0 24 24' fill='none' aria-hidden='true')
							path(d='M12 3a9 9 0 0 0-7.8 13.4L3.5 20.5l4.2-.7A9 9 0 1 0 12 3z' stroke='currentColor' stroke-width='1.6' stroke-linejoin='round')
							path(d='M9.2 9.4c.2-.4.4-.4.6-.4h.5c.2 0 .4 0 .5.3l.7 1.7c.1.2 0 .4-.1.5l-.4.5c-.1.1-.1.3 0 .5.4.7 1.1 1.4 1.9 1.9.2.1.4.1.5 0l.5-.4c.2-.1.4-.2.5-.1l1.7.7c.3.1.3.3.3.5v.5c0 .2 0 .4-.4.6A5.4 5.4 0 0 1 12 16.8 5.5 5.5 0 0 1 9.2 9.4z' fill='currentColor')
						span= aboutBannerData.whatsappCta.label
