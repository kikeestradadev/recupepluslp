include ../data/buy-banner-data

section(class='buy-banner' aria-label=buyBannerData.title)
	h1(class='visually-hidden')= buyBannerData.title
	figure(class='buy-banner__figure')
		picture(class='buy-banner__picture')
			source(
				media='(width >= 1280px)'
				srcset=buyBannerData.imageDesktop
			)
			source(
				media='(width >= 640px)'
				srcset=buyBannerData.imageTablet
			)
			img(
				class='buy-banner__image'
				src=buyBannerData.imageMobile
				alt=buyBannerData.alt
				loading='eager'
				fetchpriority='high'
			)
