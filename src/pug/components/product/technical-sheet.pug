include ../../data/ficha-tecnica-data

section(class='technical-sheet' data-lazy-component aria-labelledby='technical-sheet-title')
	div(class='main-container technical-sheet__shell')
		div(class='container technical-sheet__container')
			div(class='technical-sheet__panel')
				div(class='technical-sheet__intro')
					if fichaTecnicaData.productImage
						figure(class='technical-sheet__media')
							img(
								class='technical-sheet__product-image lazyload'
								data-src=fichaTecnicaData.productImage.src
								src='data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7'
								alt=fichaTecnicaData.productImage.alt
								width='220'
								height='220'
							)
					div(class='technical-sheet__intro-copy')
						header(class='technical-sheet__header')
							p(class='technical-sheet__eyebrow') Ficha técnica
							p(class='technical-sheet__brand')= fichaTecnicaData.brand
							h2(class='technical-sheet__title' id='technical-sheet-title')= fichaTecnicaData.productName
							if fichaTecnicaData.type
								p(class='technical-sheet__type')= fichaTecnicaData.type
							if fichaTecnicaData.presentation && fichaTecnicaData.presentation.summary
								p(class='technical-sheet__presentation')= fichaTecnicaData.presentation.summary
						if fichaTecnicaData.ingredientHighlights && fichaTecnicaData.ingredientHighlights.length
							ul(class='technical-sheet__highlights' aria-label='Ingredientes destacados')
								each highlight in fichaTecnicaData.ingredientHighlights
									li(class=`technical-sheet__highlight technical-sheet__highlight--${highlight.id}`)
										img(
											class='technical-sheet__highlight-image'
											src=highlight.image
											alt=''
											width='48'
											height='48'
											loading='lazy'
										)
										span(class='technical-sheet__highlight-label')= highlight.label
						if fichaTecnicaData.badges && fichaTecnicaData.badges.length
							ul(class='technical-sheet__badges' aria-label='Certificaciones y atributos')
								each badge in fichaTecnicaData.badges
									li(class=`technical-sheet__badge technical-sheet__badge--${badge.id}`)
										span(class='technical-sheet__badge-label')= badge.label

				div(class='technical-sheet__body')
					div(class='technical-sheet__meta')
						if fichaTecnicaData.usage
							article(class='technical-sheet__block')
								h3(class='technical-sheet__block-title')= fichaTecnicaData.usage.title
								p(class='technical-sheet__block-text')= fichaTecnicaData.usage.text
						if fichaTecnicaData.ingredients
							article(class='technical-sheet__block')
								h3(class='technical-sheet__block-title')= fichaTecnicaData.ingredients.title
								p(class='technical-sheet__block-text')= fichaTecnicaData.ingredients.text
						if fichaTecnicaData.indications
							article(class='technical-sheet__block')
								h3(class='technical-sheet__block-title')= fichaTecnicaData.indications.title
								p(class='technical-sheet__block-text')= fichaTecnicaData.indications.text
						if fichaTecnicaData.storage
							article(class='technical-sheet__block')
								h3(class='technical-sheet__block-title')= fichaTecnicaData.storage.title
								p(class='technical-sheet__block-text')= fichaTecnicaData.storage.text

					div(class='technical-sheet__tables')
						if fichaTecnicaData.specifications
							div(class='technical-sheet__table-wrap')
								h3(class='technical-sheet__table-title')= fichaTecnicaData.specifications.title
								table(class='technical-sheet__table technical-sheet__table--specs')
									tbody
										each row in fichaTecnicaData.specifications.rows
											tr(class='technical-sheet__row')
												th(class='technical-sheet__cell technical-sheet__cell--label' scope='row')= row.label
												td(class='technical-sheet__cell technical-sheet__cell--value')= row.value

						if fichaTecnicaData.nutrition
							div(class='technical-sheet__table-wrap')
								h3(class='technical-sheet__table-title')= fichaTecnicaData.nutrition.title
								div(class='technical-sheet__nutrition-meta')
									p(class='technical-sheet__nutrition-item')
										span(class='technical-sheet__nutrition-label')= fichaTecnicaData.nutrition.portionLabel
										span(class='technical-sheet__nutrition-value')= fichaTecnicaData.nutrition.portion
									p(class='technical-sheet__nutrition-item')
										span(class='technical-sheet__nutrition-label')= fichaTecnicaData.nutrition.servingsLabel
										span(class='technical-sheet__nutrition-value')= fichaTecnicaData.nutrition.servings
								table(class='technical-sheet__table technical-sheet__table--nutrition')
									thead
										tr(class='technical-sheet__row')
											th(class='technical-sheet__cell technical-sheet__cell--head' scope='col')= fichaTecnicaData.nutrition.headers.nutrient
											th(class='technical-sheet__cell technical-sheet__cell--head' scope='col')= fichaTecnicaData.nutrition.headers.amount
											th(class='technical-sheet__cell technical-sheet__cell--head' scope='col')= fichaTecnicaData.nutrition.headers.dailyValue
									tbody
										each row in fichaTecnicaData.nutrition.rows
											tr(class=row.indent ? 'technical-sheet__row technical-sheet__row--indent' : 'technical-sheet__row')
												th(class='technical-sheet__cell technical-sheet__cell--nutrient' scope='row')
													= row.nutrient
													if row.note
														span(class='technical-sheet__cell-note')= row.note
												td(class='technical-sheet__cell technical-sheet__cell--amount')= row.amount
												td(class='technical-sheet__cell technical-sheet__cell--dv')= row.dailyValue || '—'
								if fichaTecnicaData.nutrition.footnote
									p(class='technical-sheet__footnote')= fichaTecnicaData.nutrition.footnote
