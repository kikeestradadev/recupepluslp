include ../data/contact-form-data

section(class='contact-form' aria-label='Contacto')
	div(class='main-container contact-form__shell')
		div(class='container contact-form__container')
			div(class='contact-form__grid')
				div(class='contact-form__column contact-form__column--form')
					h1(class='contact-form__title')= contactFormData.formTitle
					form(class='contact-form__form' action='#' method='post')
						each field in contactFormData.fields
							div(class='contact-form__field')
								label(class='contact-form__label visually-hidden' for=field.id)= field.label
								if field.type === 'textarea'
									textarea(
										class='contact-form__control contact-form__control--textarea'
										id=field.id
										name=field.name
										placeholder=field.placeholder
										rows='5'
										required=field.required
									)
								else
									input(
										class='contact-form__control'
										id=field.id
										type=field.type
										name=field.name
										placeholder=field.placeholder
										required=field.required
									)
						button(class='contact-form__submit' type='submit')= contactFormData.submitLabel

				div(class='contact-form__column contact-form__column--info')
					h2(class='contact-form__title')= contactFormData.infoTitle
					ul(class='contact-form__info')
						each item in contactFormData.infoItems
							li(class=`contact-form__info-item contact-form__info-item--${item.type}`)
								span(class='contact-form__info-icon' aria-hidden='true')
									if item.type === 'address'
										svg(width='18' height='18' viewBox='0 0 24 24' fill='none')
											path(d='M12 21s7-5.2 7-11a7 7 0 1 0-14 0c0 5.8 7 11 7 11z' stroke='currentColor' stroke-width='1.5')
											circle(cx='12' cy='10' r='2.5' stroke='currentColor' stroke-width='1.5')
									else if item.type === 'whatsapp'
										svg(width='18' height='18' viewBox='0 0 24 24' fill='none')
											path(d='M12 3.2a8.3 8.3 0 0 0-7.2 12.4L4 20.8l5.4-.8A8.3 8.3 0 1 0 12 3.2Z' stroke='currentColor' stroke-width='1.5')
											path(d='M9.2 9.4c.2-.4.4-.4.7-.4h.5c.2 0 .4 0 .5.4l.7 1.7c.1.2 0 .4-.1.6l-.4.5c-.1.2-.1.3 0 .5.4.7 1.1 1.4 1.8 1.8.2.1.3.1.5 0l.5-.4c.2-.1.4-.2.6-.1l1.7.7c.3.1.4.3.4.5v.5c0 .3 0 .5-.4.7A5 5 0 0 1 12 16.5 5 5 0 0 1 9.2 9.4Z' fill='currentColor')
									else if item.type === 'email'
										svg(width='18' height='18' viewBox='0 0 24 24' fill='none')
											rect(x='3' y='5' width='18' height='14' rx='2' stroke='currentColor' stroke-width='1.5')
											path(d='M3 7l9 6 9-6' stroke='currentColor' stroke-width='1.5' stroke-linecap='round')
									else
										svg(width='18' height='18' viewBox='0 0 24 24' fill='none')
											rect(x='3' y='5' width='18' height='16' rx='2' stroke='currentColor' stroke-width='1.5')
											path(d='M8 3v4M16 3v4M3 10h18' stroke='currentColor' stroke-width='1.5' stroke-linecap='round')
								div(class='contact-form__info-copy')
									if item.href
										a(class='contact-form__info-link' href=item.href target=item.type === 'whatsapp' ? '_blank' : null rel=item.type === 'whatsapp' ? 'noopener noreferrer' : null)
											strong= `${item.label}: `
											span= item.text
									else
										p(class='contact-form__info-text')
											strong= `${item.label}: `
											span= item.text
