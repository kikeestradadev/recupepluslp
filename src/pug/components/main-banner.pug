include ../data/main-banner-data

section(class='main-banner' aria-label='Recuperá tu bienestar')
	div(class='main-banner__layout')
		figure(class='main-banner__media')
			picture(class='main-banner__picture')
				source(
					media='(width >= 960px)'
					srcset=mainBannerData.imageDesktop
				)
				source(
					media='(width >= 640px)'
					srcset=mainBannerData.imageTablet
				)
				img(
					class='main-banner__image'
					src=mainBannerData.imageMobile
					alt=mainBannerData.alt
					width='1200'
					height='900'
					loading='eager'
					fetchpriority='high'
				)

		div(class='main-banner__content')
			div(class='main-banner__copy')
				h1(class='main-banner__title')
					span(class='main-banner__title-line')= mainBannerData.title
					span(class='main-banner__title-line main-banner__title-line--accent')= mainBannerData.accent
				p(class='main-banner__text')= mainBannerData.text

				div(class='main-banner__actions')
					a(class='main-banner__button main-banner__button--primary' href=mainBannerData.primaryCta.href)= mainBannerData.primaryCta.label
					a(class='main-banner__button main-banner__button--whatsapp' href=mainBannerData.whatsappCta.href)
						svg(class='main-banner__button-icon' width='18' height='18' viewBox='0 0 24 24' fill='none' aria-hidden='true')
							path(d='M12 3a9 9 0 0 0-7.8 13.4L3.5 20.5l4.2-.7A9 9 0 1 0 12 3z' stroke='currentColor' stroke-width='1.6' stroke-linejoin='round')
							path(d='M9.2 9.4c.2-.4.4-.4.6-.4h.5c.2 0 .4 0 .5.3l.7 1.7c.1.2 0 .4-.1.5l-.4.5c-.1.1-.1.3 0 .5.4.7 1.1 1.4 1.9 1.9.2.1.4.1.5 0l.5-.4c.2-.1.4-.2.5-.1l1.7.7c.3.1.3.3.3.5v.5c0 .2 0 .4-.4.6A5.4 5.4 0 0 1 12 16.8 5.5 5.5 0 0 1 9.2 9.4z' fill='currentColor')
						span= mainBannerData.whatsappCta.label

				p(class='main-banner__note')
					svg(class='main-banner__note-icon' width='16' height='16' viewBox='0 0 24 24' fill='none' aria-hidden='true')
						path(d='M12 20.5C12 20.5 5 16.5 5 10.5 5 6.5 8 3.5 12 3.5s7 3 7 7c0 6-7 10-7 10z' stroke='currentColor' stroke-width='1.5' stroke-linejoin='round')
						path(d='M12 20.5V8.5' stroke='currentColor' stroke-width='1.5' stroke-linecap='round')
						path(d='M12 12.5c1.5-.8 2.8-1.2 4-1.5' stroke='currentColor' stroke-width='1.5' stroke-linecap='round')
					span= mainBannerData.note
