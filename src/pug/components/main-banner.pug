include ../data/main-banner-data

section(class='main-banner' aria-label=mainBannerData.ariaLabel)
	h1(class='visually-hidden')= mainBannerData.title
	div(class='main-banner__slider')
		button(class='main-banner__nav main-banner__nav--prev' type='button' aria-label='Anterior')
		button(class='main-banner__nav main-banner__nav--next' type='button' aria-label='Siguiente')

		div(class='main-banner__swiper swiper')
			div(class='main-banner__wrapper swiper-wrapper')
				each slide, index in mainBannerData.items
					article(class='main-banner__slide swiper-slide')
						picture
							source(
								srcset=slide.imageDesktop
								media='(min-width: 960px)'
							)
							source(
								srcset=slide.imageTablet
								media='(min-width: 640px)'
							)
							img(
								class='main-banner__image'
								src=slide.imageMobile
								alt=slide.alt
								width='500'
								height='625'
								fetchpriority=index === 0 ? 'high' : 'auto'
								decoding='async'
							)

			div(class='main-banner__pagination swiper-pagination')
