section(class='reviews-slider')
	div(class='reviews-slider__inner')
		h2(class='reviews-slider__title') Personas que ya sumaron Recupé Plus a su rutina.

		div(class='reviews-slider__slider')
			button(class='reviews-slider__nav reviews-slider__nav--prev' type='button' aria-label='Anterior')
			button(class='reviews-slider__nav reviews-slider__nav--next' type='button' aria-label='Siguiente')

			div(class='reviews-slider__swiper swiper')
				div(class='reviews-slider__wrapper swiper-wrapper')
					- const reviews = [{ quote: 'Me encanta porque es rico y fácil de tomar todos los días.', author: 'Mariana, 38', img: './assets/img1.jpg' }, { quote: 'Serenity se volvió parte de mi rutina de noche.', author: 'Andrés, 45', img: './assets/img2.jpg' }, { quote: 'Memento me acompaña en días de mucho trabajo.', author: 'Carolina, 34', img: './assets/img3.jpg' }, { quote: 'Me encanta porque es rico y fácil de tomar todos los días.', author: 'Mariana, 38', img: './assets/img4.jpg' }, { quote: 'Serenity se volvió parte de mi rutina de noche.', author: 'Andrés, 45', img: './assets/img1.jpg' }, { quote: 'Memento me acompaña en días de mucho trabajo.', author: 'Carolina, 34', img: './assets/img2.jpg' }]
					each review in reviews
						article(class='reviews-slider__slide swiper-slide')
							div(class='reviews-slider__card')
								div(class='reviews-slider__media')
									img(class='reviews-slider__image' src=review.img alt='' width='120' height='120' loading='lazy')
								div(class='reviews-slider__body')
									blockquote(class='reviews-slider__quote')= `“${review.quote}”`
									p(class='reviews-slider__author')= `— ${review.author}`
									div(class='reviews-slider__rating' aria-label='5 de 5 estrellas')
										- for (let s = 0; s < 5; s++)
											svg(class='reviews-slider__star' width='16' height='16' viewBox='0 0 24 24' aria-hidden='true')
												path(d='M12 2.5l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.8 6.2 20.4l1.1-6.5L2.6 9.3l6.5-.9L12 2.5z' fill='currentColor')

				div(class='reviews-slider__pagination swiper-pagination')
