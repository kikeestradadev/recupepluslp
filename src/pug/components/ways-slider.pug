section(class='ways-slider')
	div(class='ways-slider__inner')
		h2(class='ways-slider__title') 3 formas simples de conseguir tus productos

		div(class='ways-slider__slider')
			button(class='ways-slider__nav ways-slider__nav--prev' type='button' aria-label='Anterior')
			button(class='ways-slider__nav ways-slider__nav--next' type='button' aria-label='Siguiente')

			div(class='ways-slider__swiper swiper')
				div(class='ways-slider__wrapper swiper-wrapper')
					article(class='ways-slider__slide swiper-slide')
						div(class='ways-slider__card')
							div(class='ways-slider__content')
								span(class='ways-slider__icon' aria-hidden='true')
									svg(width='28' height='28' viewBox='0 0 24 24' fill='none')
										path(d='M12 21s7-5.2 7-11a7 7 0 1 0-14 0c0 5.8 7 11 7 11z' stroke='currentColor' stroke-width='1.8')
										circle(cx='12' cy='10' r='2.5' stroke='currentColor' stroke-width='1.8')
								h3(class='ways-slider__name') 1. Comprá online
								p(class='ways-slider__text') Elegí tus productos y recibilos en la puerta de tu casa.
								a(class='ways-slider__cta' href='#') Ir a la tienda →
							div(class='ways-slider__media')
								img(class='ways-slider__image' src='./assets/img1.jpg' alt='' width='280' height='360' loading='lazy')

