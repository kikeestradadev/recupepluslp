section(class='blog-slider')
	div(class='main-container')
		div(class='container blog-slider__inner')
			h2(class='blog-slider__title') Guías para sentirte mejor

			div(class='blog-slider__slider')
				button(class='blog-slider__nav blog-slider__nav--prev' type='button' aria-label='Anterior')
				button(class='blog-slider__nav blog-slider__nav--next' type='button' aria-label='Siguiente')

				div(class='blog-slider__swiper swiper')
					div(class='blog-slider__wrapper swiper-wrapper')
						- const posts = [{ title: '¿Cómo elegir tu Recupé Plus según tu rutina?', img: './assets/img1.jpg' }, { title: 'Hongos medicinales: qué son y cómo sumarlos a tu día.', img: './assets/img2.jpg' }, { title: 'Cómo crear un ritual simple antes de dormir.', img: './assets/img3.jpg' }, { title: 'Vitamina C, magnesio y antioxidantes: cuándo elegir cada uno.', img: './assets/img4.jpg' }, { title: '¿Cómo elegir tu Recupé Plus según tu rutina?', img: './assets/img2.jpg' }, { title: 'Hongos medicinales: qué son y cómo sumarlos a tu día.', img: './assets/img3.jpg' }, { title: 'Cómo crear un ritual simple antes de dormir.', img: './assets/img4.jpg' }, { title: 'Vitamina C, magnesio y antioxidantes: cuándo elegir cada uno.', img: './assets/img1.jpg' }]
						each post in posts
							article(class='blog-slider__slide swiper-slide')
								a(class='blog-slider__card' href='#')
									div(class='blog-slider__media')
										img(class='blog-slider__image' src=post.img alt='' width='320' height='200' loading='lazy')
									h3(class='blog-slider__name')= post.title

					div(class='blog-slider__pagination swiper-pagination')
