include ../data/blog-filter-data

section(class='blog-filter' data-blog-filter data-per-page=blogFilterData.perPage)
	div(class='main-container blog-filter__shell')
		div(class='container blog-filter__container blog-filter__inner')
			div(class='blog-filter__header')
				h2(class='blog-filter__title')= blogFilterData.title
				a(class='blog-filter__more' href=blogFilterData.moreHref)
					span= blogFilterData.moreLabel
					span(class='blog-filter__more-arrow' aria-hidden='true') →

			div(class='blog-filter__filters')
				button(class='blog-filter__filters-nav blog-filter__filters-nav--prev' type='button' aria-label='Filtros anteriores')
				button(class='blog-filter__filters-nav blog-filter__filters-nav--next' type='button' aria-label='Filtros siguientes')
				div(class='blog-filter__filters-fade blog-filter__filters-fade--start' aria-hidden='true')
				div(class='blog-filter__filters-fade blog-filter__filters-fade--end' aria-hidden='true')

				div(class='blog-filter__filters-swiper swiper')
					div(class='blog-filter__filters-wrapper swiper-wrapper')
						each filter in blogFilterData.filters
							div(class='blog-filter__filters-slide swiper-slide')
								button(
									class=filter.active ? 'blog-filter__chip blog-filter__chip--active' : 'blog-filter__chip'
									type='button'
									data-filter=filter.id
									aria-pressed=filter.active ? 'true' : 'false'
								)
									if filter.icon === 'rutina'
										svg(class='blog-filter__chip-icon' width='16' height='16' viewBox='0 0 24 24' fill='none' aria-hidden='true')
											circle(cx='12' cy='12' r='9' stroke='currentColor' stroke-width='1.6')
											path(d='M12 7v5l3 2' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round')
									else if filter.icon === 'descanso'
										svg(class='blog-filter__chip-icon' width='16' height='16' viewBox='0 0 24 24' fill='none' aria-hidden='true')
											path(d='M18 14.5A7.5 7.5 0 0 1 9.5 6 6.5 6.5 0 1 0 18 14.5Z' stroke='currentColor' stroke-width='1.6' stroke-linejoin='round')
									else if filter.icon === 'ingredientes'
										svg(class='blog-filter__chip-icon' width='16' height='16' viewBox='0 0 24 24' fill='none' aria-hidden='true')
											path(d='M5 19c4-1 6-5 7-10 1 5 3 9 7 10-3 2-11 2-14 0Z' stroke='currentColor' stroke-width='1.6' stroke-linejoin='round')
											path(d='M12 9V4' stroke='currentColor' stroke-width='1.6' stroke-linecap='round')
									else if filter.icon === 'hongos'
										svg(class='blog-filter__chip-icon' width='16' height='16' viewBox='0 0 24 24' fill='none' aria-hidden='true')
											path(d='M4 12c0-4.4 3.6-8 8-8s8 3.6 8 8H4Z' stroke='currentColor' stroke-width='1.6' stroke-linejoin='round')
											path(d='M10 12v6a2 2 0 0 0 4 0v-6' stroke='currentColor' stroke-width='1.6' stroke-linecap='round')
									else if filter.icon === 'bienestar'
										svg(class='blog-filter__chip-icon' width='16' height='16' viewBox='0 0 24 24' fill='none' aria-hidden='true')
											path(d='M12 19s-7-4.4-7-9a3.8 3.8 0 0 1 7-2 3.8 3.8 0 0 1 7 2c0 4.6-7 9-7 9Z' stroke='currentColor' stroke-width='1.6' stroke-linejoin='round')
									span= filter.label

			div(class='blog-filter__grid' data-blog-grid)
				each post in blogFilterData.posts
					article(class='blog-filter__card' data-category=post.category)
						a(class='blog-filter__media' href=post.href)
							img(class='blog-filter__image' src=post.image alt='' width='400' height='260' loading='lazy')
						p(class='blog-filter__category')= post.label
						h3(class='blog-filter__name')
							a(href=post.href)= post.title
						a(class='blog-filter__link' href=post.href)
							span Leer guía
							span(class='blog-filter__link-arrow' aria-hidden='true') →

			div(class='blog-filter__mobile')
				div(class='blog-filter__swiper swiper' data-blog-swiper)
					div(class='blog-filter__wrapper swiper-wrapper' data-blog-mobile-track)
						each post in blogFilterData.posts
							article(class='blog-filter__slide swiper-slide' data-category=post.category)
								div(class='blog-filter__card')
									a(class='blog-filter__media' href=post.href)
										img(class='blog-filter__image' src=post.image alt='' width='400' height='260' loading='lazy')
									p(class='blog-filter__category')= post.label
									h3(class='blog-filter__name')
										a(href=post.href)= post.title
									a(class='blog-filter__link' href=post.href)
										span Leer guía
										span(class='blog-filter__link-arrow' aria-hidden='true') →
				div(class='blog-filter__bullets swiper-pagination')

			nav(class='blog-filter__pagination' data-blog-pagination aria-label='Paginación del blog')
