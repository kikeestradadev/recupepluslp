include ../data/mushrooms-split-data

section(class='mushrooms-split' aria-labelledby='mushrooms-split-title')
	div(class='main-container mushrooms-split__shell')
		div(class='container mushrooms-split__container mushrooms-split__inner')
			div(class='mushrooms-split__layout')
				div(class='mushrooms-split__content')
					p(class='mushrooms-split__eyebrow')= mushroomsSplitData.eyebrow
					h2(class='mushrooms-split__title' id='mushrooms-split-title')= mushroomsSplitData.title
					span(class='mushrooms-split__badge')
						span(class='mushrooms-split__badge-icon' aria-hidden='true')
							svg(width='18' height='18' viewBox='0 0 18 18' fill='none')
								circle(cx='9' cy='9' r='7.25' stroke='currentColor' stroke-width='1.4')
								circle(cx='6.4' cy='7.6' r='0.9' fill='currentColor')
								circle(cx='11.6' cy='7.6' r='0.9' fill='currentColor')
								path(d='M6.2 11c1 1.3 2.2 1.9 2.8 1.9S10.8 12.3 11.8 11' stroke='currentColor' stroke-width='1.4' stroke-linecap='round')
						span(class='mushrooms-split__badge-text')= mushroomsSplitData.badge
					p(class='mushrooms-split__text')= mushroomsSplitData.text

				div(class='mushrooms-split__grid')
					each item in mushroomsSplitData.items
						article(class=`mushrooms-split__item mushrooms-split__item--${item.modifier}`)
							div(class='mushrooms-split__icon' aria-hidden='true')
								if item.icon === 'cordyceps'
									svg(width='120' height='140' viewBox='0 0 120 140' fill='none')
										path(d='M28 128c2-28 6-58 4-86 8 18 10 42 8 72' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
										path(d='M32 42c-2-10 2-22 10-28 2 10-1 20-6 28' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
										path(d='M52 128c1-32 8-62 2-92 10 20 14 48 10 78' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
										path(d='M54 36c0-12 6-24 16-30 1 12-3 22-10 30' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
										path(d='M78 128c-1-30 4-58-2-88 12 18 16 46 12 74' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
										path(d='M76 40c2-12 8-24 18-28-1 12-5 22-12 28' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
										path(d='M96 128c2-24 6-48 2-74 8 14 10 36 8 60' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
										path(d='M98 54c1-10 5-18 12-22-1 10-4 16-8 22' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
								else if item.icon === 'lions-mane'
									svg(width='120' height='140' viewBox='0 0 120 140' fill='none')
										path(d='M60 118v10' stroke='currentColor' stroke-width='2' stroke-linecap='round')
										path(d='M60 28c-22 2-38 18-38 40 0 20 12 34 28 40 4 8 8 12 10 12s6-4 10-12c16-6 28-20 28-40 0-22-16-38-38-40Z' stroke='currentColor' stroke-width='2' stroke-linejoin='round')
										path(d='M42 48c4-8 12-14 18-16M78 48c-4-8-12-14-18-16M36 68c2-2 6-4 10-4M84 68c-2-2-6-4-10-4M40 88c6 2 12 2 20 2s14 0 20-2' stroke='currentColor' stroke-width='1.6' stroke-linecap='round')
										path(d='M48 42c2 10 2 22 0 34M60 36c0 12 0 26 0 40M72 42c-2 10-2 22 0 34M52 50c1 8 1 18 0 28M68 50c-1 8-1 18 0 28' stroke='currentColor' stroke-width='1.4' stroke-linecap='round')
										path(d='M44 58c8 2 24 2 32 0M46 74c6 2 22 2 28 0' stroke='currentColor' stroke-width='1.4' stroke-linecap='round')
								else if item.icon === 'reishi'
									svg(width='120' height='140' viewBox='0 0 120 140' fill='none')
										path(d='M36 128V78' stroke='currentColor' stroke-width='2' stroke-linecap='round')
										path(d='M58 128V72' stroke='currentColor' stroke-width='2' stroke-linecap='round')
										path(d='M82 128V80' stroke='currentColor' stroke-width='2' stroke-linecap='round')
										path(d='M18 78c8-18 22-28 36-28-2 10-10 18-20 22-8 4-14 6-16 6Z' stroke='currentColor' stroke-width='2' stroke-linejoin='round')
										path(d='M28 58c10-16 24-24 38-22-4 10-14 16-24 18-8 2-12 4-14 4Z' stroke='currentColor' stroke-width='2' stroke-linejoin='round')
										path(d='M42 72c8-14 20-22 34-20-2 8-10 14-18 16-8 2-12 4-16 4Z' stroke='currentColor' stroke-width='2' stroke-linejoin='round')
										path(d='M54 48c8-12 20-18 32-14-2 8-10 12-18 14-6 2-10 2-14 0Z' stroke='currentColor' stroke-width='2' stroke-linejoin='round')
										path(d='M66 80c8-12 20-18 34-14-4 8-12 12-20 14-8 2-12 2-14 0Z' stroke='currentColor' stroke-width='2' stroke-linejoin='round')
										path(d='M74 62c6-10 16-16 28-12-2 6-8 10-16 12-6 2-10 2-12 0Z' stroke='currentColor' stroke-width='2' stroke-linejoin='round')

							h3(class='mushrooms-split__name')= item.title
							p(class='mushrooms-split__item-text')= item.text
