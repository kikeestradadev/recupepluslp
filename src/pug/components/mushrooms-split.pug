include ../data/mushrooms-split-data

section(class='mushrooms-split' aria-labelledby='mushrooms-split-title')
	div(class='main-container mushrooms-split__shell')
		div(class='container mushrooms-split__container mushrooms-split__inner')
			div(class='mushrooms-split__layout')
				div(class='mushrooms-split__content')
					p(class='mushrooms-split__eyebrow')= mushroomsSplitData.eyebrow
					h2(class='mushrooms-split__title' id='mushrooms-split-title')= mushroomsSplitData.title
					span(class='mushrooms-split__badge')
						span(class='mushrooms-split__badge-icon' aria-hidden='true')
							svg(width='18' height='18' viewBox='0 0 18 18' fill='none')
								circle(cx='9' cy='9' r='7.25' stroke='currentColor' stroke-width='1.4')
								circle(cx='6.4' cy='7.6' r='0.9' fill='currentColor')
								circle(cx='11.6' cy='7.6' r='0.9' fill='currentColor')
								path(d='M6.2 11c1 1.3 2.2 1.9 2.8 1.9S10.8 12.3 11.8 11' stroke='currentColor' stroke-width='1.4' stroke-linecap='round')
						span(class='mushrooms-split__badge-text')= mushroomsSplitData.badge
					p(class='mushrooms-split__text')= mushroomsSplitData.text

				div(class='mushrooms-split__slider')
					div(class='mushrooms-split__swiper swiper')
						div(class='mushrooms-split__wrapper swiper-wrapper')
							each item in mushroomsSplitData.items
								article(class=`mushrooms-split__item mushrooms-split__slide swiper-slide mushrooms-split__item--${item.modifier}`)
									div(class='mushrooms-split__icon')
										img(
											class='mushrooms-split__image'
											src=item.image
											alt=''
											width='1260'
											height='1260'
											loading='lazy'
										)
									h3(class='mushrooms-split__name visually-hidden')= item.title
									p(class='mushrooms-split__item-text')= item.text
						div(class='mushrooms-split__pagination swiper-pagination')
